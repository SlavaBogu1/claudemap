# npm configuration for Claude Session Explorer
# This file ensures consistent behavior across all systems and developers

# Security: verify package integrity (always enabled in npm 6+)
audit=true

# Performance: prefer offline cache when available (faster installs on subsequent runs)
prefer-offline=true

# Lockfile: ensure lock files are always updated during installs
lockfile=true

# Registry: use default npm registry (can be overridden by CI/CD)
# registry=https://registry.npmjs.org/

# Save dependencies to package.json by default (recommended for workspaces)
save=true

# Strict SSL verification (set to false only in trusted internal networks)
strict-ssl=true

# Engine check: ensure Node.js version matches package.json requirement
engine-strict=true

# Workspace strict mode: require explicit -w flag for workspace commands
# workspace-concurrency=1

# Fail on script execution errors (fail fast on setup)
ignore-scripts=false
